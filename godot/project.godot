; Engine configuration file.
; Godot 4.3+ OpenXR stub for the native Quest port.
; The live browser game stays in ../public/
config_version=5

[application]

config/name="Defuse Protocol"
config/description="Native Quest port. Puzzle logic will live here; the WebXR game stays in public/."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "4.7", "Mobile")
config/icon="res://icon.svg"

[autoload]

Sound="*res://scripts/autoload/sound.gd"
Prefs="*res://scripts/autoload/prefs.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[rendering]

renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true

[xr]

openxr/enabled=true
shaders/enabled=true
